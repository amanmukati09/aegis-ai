# ============================================================
# AegisAI — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# All accounts/keys are YOUR PERSONAL ones (no office/TCS).
# ============================================================

# --- Core app ---
APP_ENV=dev
SPRING_PROFILES_ACTIVE=dev
APP_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth / JWT ---
JWT_SECRET=change-me-generate-a-long-random-string-min-32-bytes
JWT_EXPIRY_DAYS=7

# --- Bootstrap platform super_admin (created once if none exists) ---
# Leave password blank to skip bootstrapping (safe default). Set it to seed an admin.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Admin

# --- PostgreSQL (core, required) ---
POSTGRES_DB=aegisai
POSTGRES_USER=aegisai
POSTGRES_PASSWORD=change-me
# JDBC url used by the gateway (host = compose service name)
POSTGRES_URL=jdbc:postgresql://postgres:5432/aegisai

# --- Redis (core, required) ---
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379

# --- ML service wiring ---
ML_SERVICE_URL=http://ml-service:8001
VECTOR_STORE=pgvector

# --- AI providers ---
# Default is Groq (free hosted). Ollama is optional/off (too heavy for a small box).
DEFAULT_AI_PROVIDER=groq
# Groq model IDs change over time; verify with infra/scripts/list-groq-models.sh.
DEFAULT_AI_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional local Ollama (leave blank to disable). Point at a host/remote if you run it.
OLLAMA_URL=

# --- OAuth2 (free; register apps under YOUR PERSONAL accounts) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Optional adapters (blank = off) ---
KAFKA_BOOTSTRAP=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
TIMESCALE_URL=

# --- Optional alert channels (blank = off; stdout used in dev) ---
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
OPSGENIE_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAILS=
